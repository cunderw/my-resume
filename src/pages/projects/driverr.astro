---
import Layout from '@/layouts/Layout.astro'

const features = [
  {
    title: 'Which agent is waiting on you',
    body: 'Every blocked agent is collected at the top of the session, named with the workspace and tab it came from. The answer to "is anything waiting on me?" is the first thing on screen, not something you go looking for in a grid of characters.',
  },
  {
    title: 'Answer without reading a terminal',
    body: 'A composer with a text field and the keys a phone keyboard does not have — Escape, Ctrl-C, arrows, y and n. Two taps to unblock an agent from a phone, without pinch-zooming a 120-column screen.',
  },
  {
    title: 'A real terminal when you want one',
    body: 'Attach to any pane, with a key row for the characters iOS hides, and themes and type sizes you can change while looking at the terminal rather than guessing. Split, rename or close a pane from the toolbar, and open a new one from the pane switcher.',
  },
  {
    title: 'Private by architecture',
    body: 'Driverr talks straight to machines you own. Keys and passwords live in the iOS keychain and never leave the device. Host keys are checked on first sight and a change stops the connection hard. No accounts, no analytics, no backend of mine anywhere in the path.',
  },
]

const tech = [
  ['SwiftUI + @Observable', 'iOS 26, universal iPhone and iPad, Swift 6 with strict concurrency'],
  [
    'SwiftNIO SSH',
    'a real SSH client — Ed25519 keys generated or imported on device, password auth, and trust-on-first-use host key checking',
  ],
  [
    'Strict layering',
    'NIOSSH types never leave the SSH module and herdr wire types never leave the herdr module, so stores are testable with no socket and upstream churn is confined to one file each',
  ],
  [
    'A terminal that tests in milliseconds',
    'SwiftTerm is wrapped behind a byte-stream feed, so the session logic runs against a headless terminal in unit tests instead of a simulator',
  ],
]
---

<Layout
  title="Driverr — Carson Underwood"
  description="A native iOS SSH client built around herdr: see which coding agent is blocked and answer it from your phone, without reading a terminal."
>
  <div class="space-y-8">
    <div class="rounded-xl border border-slate-700/50 bg-slate-800 p-8 shadow-xl">
      <div class="flex flex-col items-start gap-6 md:flex-row md:items-center">
        <img
          src="/projects/driverr/icon.png"
          alt="Driverr app icon"
          width="96"
          height="96"
          class="rounded-2xl border border-slate-700/50 shadow-lg"
        />
        <div>
          <h1 class="text-2xl font-bold text-slate-100">Driverr</h1>
          <p class="mt-1 text-sm leading-relaxed text-slate-300">
            A native iOS SSH client built around <a
              href="https://github.com/herdrdev/herdr"
              class="text-cyan-400 hover:underline"
              rel="noopener">herdr</a
            > &mdash; see which coding agent is blocked, and answer it from your phone without reading
            a terminal.
          </p>
          <p class="mt-2 font-mono text-xs text-slate-500">
            SwiftUI &middot; SwiftNIO SSH &middot; iPhone + iPad &middot; free and open source
          </p>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-3 gap-2 md:gap-4">
      <img
        src="/projects/driverr/needs-you.png"
        alt="Session view: a Needs you section listing the blocked agent above the workspace tree"
        class="w-full rounded-xl border border-slate-700/50 shadow-lg"
        loading="lazy"
      />
      <img
        src="/projects/driverr/reply.png"
        alt="Composer: a text field and a row of keys a phone keyboard lacks, for answering an agent"
        class="w-full rounded-xl border border-slate-700/50 shadow-lg"
        loading="lazy"
      />
      <img
        src="/projects/driverr/terminal.png"
        alt="Terminal attached to a pane, showing a live agent session with a key row above the keyboard"
        class="w-full rounded-xl border border-slate-700/50 shadow-lg"
        loading="lazy"
      />
    </div>

    <div class="rounded-xl border border-slate-700/50 bg-slate-800 p-8 shadow-xl">
      <h2 class="mb-4 text-base font-semibold text-slate-100">What it does</h2>
      <div class="space-y-5 text-sm leading-relaxed text-slate-300">
        {
          features.map(({ title, body }) => (
            <section>
              <h3 class="mb-1 font-semibold text-cyan-400">{title}</h3>
              <p class="text-slate-400">{body}</p>
            </section>
          ))
        }
      </div>
    </div>

    <div class="rounded-xl border border-slate-700/50 bg-slate-800 p-8 shadow-xl">
      <h2 class="mb-4 text-base font-semibold text-slate-100">How it&rsquo;s built</h2>
      <ul class="space-y-2 text-sm">
        {
          tech.map(([name, detail]) => (
            <li class="flex gap-2 text-slate-400">
              <span class="select-none text-cyan-500">&rsaquo;</span>
              <span>
                <strong class="text-slate-300">{name}</strong> — {detail}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-sm text-slate-400">
        Driverr is most useful alongside herdr, which keeps coding agents running in persistent
        background terminals; it works as a plain SSH client without it. It is an independent
        project and is not affiliated with or endorsed by the herdr project or Anthropic.
      </p>
      <p class="mt-4 text-sm text-slate-400">
        Privacy policy:
        <a href="/privacy-policy/driverr" class="text-cyan-400 hover:underline">
          cunderw.dev/privacy-policy/driverr
        </a>
        &middot; Questions? <a href="/contact" class="text-cyan-400 hover:underline">Get in touch</a>.
      </p>
    </div>
  </div>
</Layout>
