---
import Layout from '@/layouts/Layout.astro'

const features = [
  {
    title: 'Your whole server at a glance',
    body: 'Array status, capacity, and parity state the moment the app opens, alongside CPU, memory, uptime, and per-disk temperature and usage. Tap any disk for its size, free space, filesystem, and health.',
  },
  {
    title: 'Real control, not just monitoring',
    body: 'Start, stop, restart, pause, and resume Docker containers. Start, shut down, reboot, pause, resume — and force stop — virtual machines. Anything disruptive asks first, because these are real services.',
  },
  {
    title: 'Shares, notifications, and logs',
    body: 'Browse every user share with its allocation and usage, read and clear the notifications your server has raised, and open system log files directly — without reaching for a terminal.',
  },
  {
    title: 'Private by architecture',
    body: 'Tower talks straight to a machine you own. Your API key lives in the iOS keychain and never leaves the device. No accounts, no analytics, no ads, no telemetry, and no backend of mine anywhere in the path.',
  },
]

const tech = [
  ['SwiftUI + @Observable', 'iOS 26, universal iPhone and iPad with adaptive split-view layouts'],
  [
    'Apollo GraphQL',
    'codegen from the introspected Unraid schema, so a server-side change breaks the build instead of the app',
  ],
  [
    'Strict layering',
    'a Swift package split into a model core with no Apollo dependency and a data layer that owns it — generated types never escape the repository boundary',
  ],
  [
    'Demo mode as a repository',
    'the same protocol as the live client, backed by seeded data — it powers both the App Store screenshots and the UI-test tour',
  ],
]
---

<Layout
  title="Tower — Carson Underwood"
  description="A native iOS client for your own Unraid server: dashboard, Docker, virtual machines, and shares, with no cloud in between."
>
  <div class="space-y-8">
    <div class="rounded-xl border border-slate-700/50 bg-slate-800 p-8 shadow-xl">
      <div class="flex flex-col items-start gap-6 md:flex-row md:items-center">
        <img
          src="/projects/tower/icon.png"
          alt="Tower app icon"
          width="96"
          height="96"
          class="rounded-2xl border border-slate-700/50 shadow-lg"
        />
        <div>
          <h1 class="text-2xl font-bold text-slate-100">Tower</h1>
          <p class="mt-1 text-sm leading-relaxed text-slate-300">
            A native iOS client for your own Unraid server &mdash; array health, Docker
            containers, virtual machines, and shares, with real controls and no cloud in
            between.
          </p>
          <p class="mt-2 font-mono text-xs text-slate-500">
            SwiftUI &middot; Apollo GraphQL &middot; iPhone + iPad &middot; preparing for release
          </p>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-3 gap-2 md:gap-4">
      <img
        src="/projects/tower/dashboard.png"
        alt="Dashboard: array capacity and parity state above system metrics and per-disk temperatures"
        class="w-full rounded-xl border border-slate-700/50 shadow-lg"
        loading="lazy"
      />
      <img
        src="/projects/tower/docker.png"
        alt="Docker tab: running containers with their state, image, and uptime"
        class="w-full rounded-xl border border-slate-700/50 shadow-lg"
        loading="lazy"
      />
      <img
        src="/projects/tower/shares.png"
        alt="Shares tab: every user share with its description, searchable"
        class="w-full rounded-xl border border-slate-700/50 shadow-lg"
        loading="lazy"
      />
    </div>

    <div class="rounded-xl border border-slate-700/50 bg-slate-800 p-8 shadow-xl">
      <h2 class="mb-4 text-base font-semibold text-slate-100">What it does</h2>
      <div class="space-y-5 text-sm leading-relaxed text-slate-300">
        {
          features.map(({ title, body }) => (
            <section>
              <h3 class="mb-1 font-semibold text-cyan-400">{title}</h3>
              <p class="text-slate-400">{body}</p>
            </section>
          ))
        }
      </div>
    </div>

    <div class="rounded-xl border border-slate-700/50 bg-slate-800 p-8 shadow-xl">
      <h2 class="mb-4 text-base font-semibold text-slate-100">How it&rsquo;s built</h2>
      <ul class="space-y-2 text-sm">
        {
          tech.map(([name, detail]) => (
            <li class="flex gap-2 text-slate-400">
              <span class="select-none text-cyan-500">&rsaquo;</span>
              <span>
                <strong class="text-slate-300">{name}</strong> — {detail}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-sm text-slate-400">
        Tower requires an Unraid server with its GraphQL API enabled. It is an independent
        project, not affiliated with or endorsed by Lime Technology, Inc.
      </p>
      <p class="mt-4 text-sm text-slate-400">
        Privacy policy:
        <a href="/privacy-policy/tower" class="text-cyan-400 hover:underline">
          cunderw.dev/privacy-policy/tower
        </a>
        &middot; Questions? <a href="/contact" class="text-cyan-400 hover:underline">Get in touch</a>.
      </p>
    </div>
  </div>
</Layout>
